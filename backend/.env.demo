# Qyzyljar AI: public demo configuration for local judging.
# Copy to backend/.env; the launcher reads .env, not .env.demo.
# NO SHARED KEY IS INCLUDED. Keep this template key-free.
# With an empty key: simulation, Python verification and strategies work;
# real AI analysis and dialogue stay disabled. No fake AI responses.
# Add your own key ONLY to the private backend/.env for optional paid AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
HOST=127.0.0.1
PORT=3010
FRONTEND_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Leave empty to use the bundled synthetic dataset.
DATASET_PATH=
AI_REQUESTS_PER_MINUTE=5
# Optional full path to Python 3.10+; leave empty for auto-detection.
PYTHON_BIN=
