# Copy to backend/.env for optional live AI. Never add a real key to this template.
# For a key-free judges demo, see backend/.env.demo and the root README.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
HOST=127.0.0.1
PORT=3010
FRONTEND_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Optional path to a replacement JSON dataset, relative to backend/.
DATASET_PATH=
# AI requests per IP in a one-minute window; one server process, demo use.
AI_REQUESTS_PER_MINUTE=5
# Optional full path to Python 3.10+; otherwise detected locally.
PYTHON_BIN=
