# Локально: скопируйте в .env и заполните ключ. Никогда не публикуйте .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=5181
# Альтернатива пустому OPENAI_API_KEY: удалите его строку из .env и задайте
# путь к существующему env-файлу. Из него будет прочитан только ключ, не PORT.
# OPENAI_ENV_FILE=../backend/.env
